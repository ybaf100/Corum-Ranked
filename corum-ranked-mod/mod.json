{
  "geode": "5.8.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "hwanhee1.corum_ranked",
  "name": "Corum Ranked",
  "version": "v0.5.0-beta.5",
  "developer": "hwanhee1",
  "description": "A separate server-authoritative Corum Ranked client. It does not share runtime state or UI with Corum Integration.",
  "dependencies": {
    "syzzi.click_between_frames": ">=v1.5.0"
  },
  "tags": [
    "online",
    "gameplay",
    "interface"
  ],
  "resources": {
    "sprites": [
      "resources/corum-trophy-*.png"
    ],
    "files": [
      "resources/CorumSans-LICENSE.txt"
    ],
    "fonts": {
      "CorumSans": {
        "path": "resources/CorumSans.ttf",
        "size": 64,
        "charset": "32-126,183,8226"
      },
      "CorumSansMedium": {
        "path": "resources/CorumSansMedium.ttf",
        "size": 64,
        "charset": "32-126,183,8226"
      },
      "CorumSansSemiBold": {
        "path": "resources/CorumSansSemiBold.ttf",
        "size": 64,
        "charset": "32-126,183,8226,44536,46356,48260"
      },
      "CorumSansBold": {
        "path": "resources/CorumSansBold.ttf",
        "size": 64,
        "charset": "32-126,183,8226"
      },
      "CorumSansBlack": {
        "path": "resources/CorumSansBlack.ttf",
        "size": 64,
        "charset": "32-126,183,8226"
      }
    }
  },
  "settings": {
    "ranked-server-url": {
      "name": "Ranked server URL",
      "description": "Base URL of the Corum Ranked server. HTTPS is required except for localhost development. This is not a secret.",
      "type": "string",
      "default": "https://corum-ranked.onrender.com"
    },
    "poll-interval-ms": {
      "name": "Polling interval (ms)",
      "description": "REST short-poll interval. The server remains authoritative for clocks and deadlines.",
      "type": "int",
      "default": 1000,
      "min": 250,
      "max": 5000
    }
  }
}
