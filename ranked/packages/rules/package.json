{
  "name": "@corum-ranked/rules",
  "version": "0.5.0-beta.126",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prebuild": "node ../../tools/localization/build.mjs --target rules",
    "pretest": "node ../../tools/localization/build.mjs --target rules",
    "pretypecheck": "node ../../tools/localization/build.mjs --target rules"
  }
}
