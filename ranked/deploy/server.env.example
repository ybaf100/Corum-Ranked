# TEMPLATE ONLY — DO NOT COMMIT PRODUCTION VALUES.
# Save real values as root-owned /etc/corum-ranked/server.env on Lightsail.
# Fresh credentials are required after Railway's October 2026 incident.
NODE_ENV=production
PORT=3000
DATABASE_URL=<NEW-NEON-STAGING-OR-PRODUCTION-URL>
RANKED_CONFIG_URL=<EXISTING-HTTPS-APPS-SCRIPT-URL>
RANKED_CONFIG_REFRESH_MS=60000
RANKED_CONFIG_FETCH_TIMEOUT_MS=10000
RANKED_CSMP_FETCH_TIMEOUT_MS=30000
RANKED_SESSION_TOKEN_SECRET=<NEW-64-HEX-CHAR-SECRET>
CORS_ORIGINS=
RANKED_DOWNLOAD_BASE_URL=<EXISTING-R2-PUBLIC-BASE-URL>
ENABLE_DEBUG_BOT_MATCH=false
ENABLE_DEBUG_SPECTATE=false
# Optional; configure both when using Cloudflare GD Relay:
# SURVIVAL_GD_RELAY_ORIGIN=https://YOUR-RELAY.workers.dev
# SURVIVAL_GD_RELAY_TOKEN=<NEW-TOKEN-SAME-AS-WORKER-GD_RELAY_TOKEN>
# Optional; rotate Webhook if enabled:
# DISCORD_WEBHOOK_URL=<NEW-DISCORD-WEBHOOK>
# DISCORD_OUTBOX_POLL_MS=...
# DISCORD_OUTBOX_BATCH_SIZE=...
# DISCORD_REQUEST_TIMEOUT_MS=...
# DISCORD_OUTBOX_LEASE_MS=...
# DISCORD_RETRY_BASE_MS=...
# DISCORD_RETRY_MAXIMUM_MS=...
# DISCORD_MAXIMUM_ATTEMPTS=...
