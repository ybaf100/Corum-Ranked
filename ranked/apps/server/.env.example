NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ranked_user:<set-database-password>@127.0.0.1:5432/corum_ranked
RANKED_CONFIG_URL=https://script.google.com/macros/s/<set-apps-script-deployment-id>/exec?action=ranked_config
RANKED_CONFIG_REFRESH_MS=<set-refresh-interval-ms>
RANKED_CONFIG_FETCH_TIMEOUT_MS=<set-fetch-timeout-ms>
RANKED_SESSION_TOKEN_SECRET=<set-a-long-random-secret-in-deployment-only>
CORS_ORIGINS=
ENABLE_DEBUG_BOT_MATCH=false
DEBUG_BOT_PASSWORD=
DISCORD_WEBHOOK_URL=
DISCORD_OUTBOX_POLL_MS=<set-poll-interval-ms-when-enabled>
DISCORD_OUTBOX_BATCH_SIZE=<set-batch-size-when-enabled>
DISCORD_REQUEST_TIMEOUT_MS=<set-request-timeout-ms-when-enabled>
DISCORD_OUTBOX_LEASE_MS=<set-lease-ms-greater-than-request-timeout-when-enabled>
DISCORD_RETRY_BASE_MS=<set-retry-base-ms-when-enabled>
DISCORD_RETRY_MAXIMUM_MS=<set-retry-cap-ms-when-enabled>
DISCORD_MAXIMUM_ATTEMPTS=<set-maximum-attempts-when-enabled>
